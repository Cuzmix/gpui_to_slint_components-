// Port of ely-core/src/typography/inline.rs (`Blockquote`).
// A quoted passage behind a rule.
//
// gpui's children take the quote's muted, medium-size text; Slint texts do not inherit a style,
// so `text` draws a passage in that style, and children set their own (gap G21).

import { Theme, TextSize } from "../theme/theme.slint";
import { TypeText } from "type-text.slint";

export component Blockquote inherits HorizontalLayout {
    // A passage in the quote's style; leave empty to give children instead.
    in property <string> text;
    // The style children should take, as gpui's quote hands it down.
    out property <color> ink: Theme.colors.fg-muted;
    out property <length> text-size: Theme.text-size(TextSize.md);

    // A block: full width, as tall as its passage.
    vertical-stretch: 0;

    // The 2 px rule.
    Rectangle {
        width: 2px;
        background: Theme.colors.border-strong;
    }

    // 16 px before the passage.
    VerticalLayout {
        padding-left: 16px;
        if root.text != "": TypeText {
            text: root.text;
            color: root.ink;
            font-size: root.text-size;
        }
        @children
    }
}
