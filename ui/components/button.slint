// Port of ely-core/src/buttons/button.rs (`Button`).
// A pressable button: a label, an icon at either end, a shortcut hint.

import { Theme, ControlSize, TextSize } from "../theme/theme.slint";
import { ButtonVariant, ButtonStyle, GroupSlot } from "button-style.slint";
import { ButtonFrame } from "button-frame.slint";
import { Icon } from "icon.slint";
import { Spinner } from "spinner.slint";

export { ButtonVariant, GroupSlot }
export component Button {
    // What it reads.
    in property <string> text;
    // The name assistive technology reads for a button that draws no label; nothing is drawn.
    in property <string> accessible-name;
    // An icon before the label.
    in property <image> icon;
    // An icon after the label.
    in property <image> trailing-icon;
    // The keystroke that also runs it, already spelled for the platform: "⌘S" or "Ctrl+S".
    // `ely_slint::shortcut_text` spells GPUI key syntax ("secondary-s") this way.
    in property <string> shortcut;
    // Its look.
    in property <ButtonVariant> variant: ButtonVariant.secondary;
    // Its height and text size.
    in property <ControlSize> size: ControlSize.md;
    // False dims it and takes no press; a disabled button is no Tab stop.
    in property <bool> enabled: true;
    // Spins in place of its content, at the same width, and ignores presses. Tab still reaches it.
    in property <bool> loading: false;
    // Stretches it across its container.
    in property <bool> full-width: false;
    // Where it sits inside a ButtonGroup.
    in property <GroupSlot> group-slot: GroupSlot.none;

    out property <bool> has-focus: frame.has-focus;
    out property <color> current-fill: frame.current-fill;
    out property <color> current-border: frame.current-border;

    // Runs on a press, or on Enter or Space released while focused.
    callback clicked();

    forward-focus: frame;
    height: Theme.control-height(size);
    // Never grows; shrinks only when a row cannot fit it.
    horizontal-stretch: full-width ? 1 : 0;
    min-width: 0;

    private property <bool> is-link: variant == ButtonVariant.link;
    private property <color> fg: frame.tone.fg;

    frame := ButtonFrame {
        width: 100%;
        height: 100%;
        variant: root.variant;
        enabled: root.enabled;
        busy: root.loading;
        group-slot: root.group-slot;
        accessible-name: root.text != "" ? root.text : root.accessible-name;
        clicked => {
            root.clicked();
        }

        parts := HorizontalLayout {
            padding-left: root.is-link ? 0 : Theme.control-padding(root.size);
            padding-right: self.padding-left;
            spacing: 6px;
            alignment: center;
            opacity: root.loading ? 0 : 1;

            if root.icon.width > 0: Icon {
                y: (parent.height - self.height) / 2;
                source: root.icon;
                size: ButtonStyle.icon-size(root.size);
                color: root.fg;
            }
            if root.text != "": label := Text {
                text: root.text;
                color: root.fg;
                font-size: Theme.text-size(ButtonStyle.text-size(root.size));
                font-weight: 500;
                font-family: Theme.font-family;
                vertical-alignment: center;
                // Text never wraps by default. Spelling out `wrap: no-wrap` makes Slint 1.18.1
                // measure the Text by width, and a FlexboxLayout then misplaces the button.
                overflow: elide;
                min-width: 0;

                // GPUI underlines a link while hovered.
                if root.is-link && frame.has-hover && root.enabled && !root.loading: Rectangle {
                    x: 0;
                    width: parent.width;
                    y: (parent.height + parent.font-size) / 2;
                    height: Theme.underline-thickness;
                    background: root.fg;
                }
            }
            if root.trailing-icon.width > 0: Icon {
                y: (parent.height - self.height) / 2;
                source: root.trailing-icon;
                size: ButtonStyle.icon-size(root.size);
                color: root.fg;
            }
            if root.shortcut != "": HorizontalLayout {
                padding-left: 4px;
                Text {
                    text: root.shortcut;
                    color: Theme.opacity(root.fg, 0.55);
                    font-size: Theme.text-size(ButtonStyle.text-size(root.size));
                    font-weight: 400;
                    font-family: Theme.font-family;
                    vertical-alignment: center;
                }
            }
        }

        if root.loading: Spinner {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: ButtonStyle.icon-size(root.size);
            color: root.fg;
        }
    }
}
