// Port of ely-core/src/forms/date/calendar.rs (`Calendar`): a month of days. Arrows move a
// cursor (a day, a week), Page Up and Page Down a month, Home and End to the week's ends; Enter
// or Space picks the cursor's day, a press picks any day in range. The arrows in the header turn
// the month; each turn slides the days in from its side.
//
// It opens on `anchor`, else the chosen day, else the span's first, else today, and opens there
// again whenever that day changes. Needs `wire_dates!` (dates.slint).

import { Theme, ControlSize, Radius, TextSize } from "../theme/theme.slint";
import { IconButton } from "icon-button.slint";
import { ButtonVariant } from "button-style.slint";
import { Icons } from "../icons/icons.slint";
import { TypeText } from "type-text.slint";
import { CivilDate, Dates, DateMath, DateWords } from "dates.slint";

export component Calendar {
    // The day chosen; none when its year is 0.
    in property <CivilDate> selected;
    // A run of days: ink at both ends, a band between.
    in property <CivilDate> span-start;
    in property <CivilDate> span-end;
    // Shades the whole week under the pointer.
    in property <bool> week;
    // The first and last days it lets you pick; unset, no limit.
    in property <CivilDate> minimum;
    in property <CivilDate> maximum;
    // The day ringed as today.
    in property <CivilDate> today: Dates.today;
    // The day whose month opens first, when the marks move while picking.
    in property <CivilDate> anchor;
    in property <string> unavailable-text: @tr("Unavailable");

    out property <bool> has-focus: keys.has-focus;
    // The month shown (its first day), the cursor's day, and the day under the pointer.
    out property <CivilDate> month;
    out property <CivilDate> cursor;
    out property <CivilDate> hovered;

    // A day in range was pressed, or picked with Enter or Space.
    callback picked(date: CivilDate);
    // The pointer came over a day (none when it left the days), or the cursor moved to one.
    callback hovered-changed(date: CivilDate);
    // Escape; accept it to take the key.
    callback escape() -> EventResult;

    private property <CivilDate> seed: DateMath.is-set(root.anchor) ? root.anchor : DateMath.is-set(root.selected) ? root.selected : DateMath.is-set(root.span-start) ? root.span-start : root.today;
    private property <bool> spans: DateMath.is-set(root.span-start) && DateMath.is-set(root.span-end);
    private property <[CivilDate]> days: Dates.grid(root.month);
    private property <length> cell: Theme.control-height(ControlSize.md);
    // The last turn's direction, and its entrance from 0 to 1.
    private property <bool> forward;
    private property <duration> turned-at;
    private property <bool> turning;
    private property <float> turn-in: root.turning ? Theme.ease-out-cubic(clamp((animation-tick() - root.turned-at) / Theme.motion-base, 0, 1)) : 1;

    function reseed() {
        root.month = DateMath.first-of-month(root.seed);
        root.cursor = root.seed;
    }

    init => {
        root.reseed();
    }
    changed seed => {
        root.reseed();
    }

    // Shows `next`'s month, sliding in from its side.
    function turn(next: CivilDate) {
        let first = DateMath.first-of-month(next);
        if DateMath.same(first, root.month) {
            return;
        }
        root.forward = DateMath.key(first) > DateMath.key(root.month);
        root.month = first;
        root.turned-at = animation-tick();
        root.turning = true;
        settle.running = true;
        settle.restart();
    }

    function pick(date: CivilDate) {
        if !DateMath.within(date, root.minimum, root.maximum) {
            return;
        }
        root.cursor = date;
        root.turn(date);
        root.picked(date);
    }

    function move-to(next: CivilDate) {
        root.cursor = next;
        root.turn(next);
        root.hovered-changed(next);
    }

    settle := Timer {
        interval: Theme.motion-base;
        running: false;
        triggered => {
            self.running = false;
            root.turning = false;
        }
    }

    forward-focus: keys;
    width: root.cell * 8;
    height: column.preferred-height;
    accessible-role: table;
    accessible-label: DateWords.month(root.month);
    accessible-value: DateMath.is-set(root.cursor) ? DateWords.day(root.cursor) : "";

    keys := FocusScope {
        key-pressed(event) => {
            let at = root.cursor;
            if event.text == Key.LeftArrow {
                root.move-to(Dates.shift(at, -1, 0));
            } else if event.text == Key.RightArrow {
                root.move-to(Dates.shift(at, 1, 0));
            } else if event.text == Key.UpArrow {
                root.move-to(Dates.shift(at, -7, 0));
            } else if event.text == Key.DownArrow {
                root.move-to(Dates.shift(at, 7, 0));
            } else if event.text == Key.PageUp {
                root.move-to(Dates.shift(at, 0, -1));
            } else if event.text == Key.PageDown {
                root.move-to(Dates.shift(at, 0, 1));
            } else if event.text == Key.Home {
                root.move-to(Dates.week-start(at));
            } else if event.text == Key.End {
                root.move-to(Dates.shift(Dates.week-start(at), 6, 0));
            } else if event.text == Key.Return || event.text == " " {
                root.pick(at);
            } else if event.text == Key.Escape {
                return root.escape();
            } else {
                return reject;
            }
            accept
        }
    }

    column := VerticalLayout {
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            cross-axis-alignment: center;

            TypeText {
                horizontal-stretch: 1;
                text: DateWords.month(root.month);
                font-size: Theme.text-size(TextSize.base);
                font-weight: 600;
                color: Theme.colors.fg;
                wrap: no-wrap;
                accessible-role: none;
            }

            HorizontalLayout {
                spacing: 2px;

                IconButton {
                    icon: Icons.chevron-left;
                    size: ControlSize.sm;
                    variant: ButtonVariant.ghost;
                    tooltip: @tr("Previous month");
                    clicked => {
                        root.cursor = Dates.shift(root.cursor, 0, -1);
                        root.turn(root.cursor);
                    }
                }

                IconButton {
                    icon: Icons.chevron-right;
                    size: ControlSize.sm;
                    variant: ButtonVariant.ghost;
                    tooltip: @tr("Next month");
                    clicked => {
                        root.cursor = Dates.shift(root.cursor, 0, 1);
                        root.turn(root.cursor);
                    }
                }
            }
        }

        HorizontalLayout {
            for name in DateWords.weekdays: TypeText {
                width: (root.width - 16px) / 7;
                text: name;
                font-size: Theme.text-size(TextSize.xs);
                color: Theme.colors.fg-subtle;
                horizontal-alignment: center;
                wrap: no-wrap;
                accessible-role: none;
            }
        }

        grid := Rectangle {
            height: root.cell * 6 + 2px * 5;

            // Leaving the days ends the hover.
            TouchArea {
                changed has-hover => {
                    if !self.has-hover {
                        root.hovered = { };
                        root.hovered-changed({ });
                    }
                }

                days := Rectangle {
                    x: (root.forward ? 12px : -12px) * (1 - root.turn-in);
                    opacity: root.turn-in;

                    for date[ix] in root.days: Rectangle {
                        property <bool> open: DateMath.within(date, root.minimum, root.maximum);
                        property <bool> chosen: DateMath.same(root.selected, date) || (root.spans && (DateMath.same(root.span-start, date) || DateMath.same(root.span-end, date)));
                        property <bool> inside: (root.spans && DateMath.key(root.span-start) < DateMath.key(date) && DateMath.key(date) < DateMath.key(root.span-end)) || (root.week && DateMath.is-set(root.hovered) && DateMath.same(Dates.week-start(root.hovered), Dates.week-start(date)));
                        property <bool> now: DateMath.same(root.today, date);

                        x: mod(ix, 7) * (root.cell + 2px);
                        y: floor(ix / 7) * (root.cell + 2px);
                        width: root.cell;
                        height: root.cell;
                        border-radius: Theme.radius(Radius.md);
                        border-width: 1px;
                        border-color: keys.has-focus && DateMath.same(root.cursor, date) ? Theme.colors.focus : self.now && !self.chosen ? Theme.colors.border-strong : transparent;
                        background: self.chosen ? Theme.colors.accent : self.inside ? Theme.colors.active : self.open && touch.has-hover ? Theme.colors.hover : transparent;
                        accessible-role: list-item;
                        accessible-label: DateWords.day(date);
                        accessible-item-selectable: true;
                        accessible-item-selected: self.chosen;
                        accessible-description: self.open ? "" : root.unavailable-text;
                        accessible-action-default => {
                            root.pick(date);
                        }

                        Text {
                            text: date.day;
                            font-family: Theme.font-family;
                            font-size: Theme.text-size(TextSize.sm);
                            font-weight: parent.now ? 600 : 400;
                            color: parent.chosen ? Theme.colors.on-accent : !parent.open ? Theme.colors.fg-disabled : date.month != root.month.month ? Theme.colors.fg-subtle : Theme.colors.fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }

                        touch := TouchArea {
                            enabled: parent.open;
                            mouse-cursor: MouseCursor.pointer;
                            changed has-hover => {
                                if self.has-hover {
                                    root.hovered = date;
                                    root.hovered-changed(date);
                                }
                            }
                            // A press focuses the calendar, as gpui's tracked focus does.
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                                    keys.focus();
                                }
                            }
                            clicked => {
                                root.pick(date);
                            }
                        }
                    }
                }
            }
        }
    }
}
