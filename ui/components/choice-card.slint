// Port of ely-core/src/forms/card.rs: `CheckboxCard`, `RadioCard`. A bordered choice: the mark,
// then a title, a line under it and a preview (the children) under them, and an icon at its end.
// The border turns accent while chosen, focus while focused, border-strong on hover otherwise.
//
// Like the boxes they wrap (gap G48), `checked` and `on` are `in-out`: a press sets them.

import { Theme, IconSize, Radius, TextSize } from "../theme/theme.slint";
import { Icon } from "icon.slint";
import { TypeText } from "type-text.slint";
import { ClickKeys } from "click-keys.slint";
import { CheckMark, CheckState } from "checkbox.slint";
import { RadioMark } from "radio.slint";

// The card both build on: `radio` picks the mark.
export component ChoiceCard {
    in property <string> title;
    // A line under the title.
    in property <string> description;
    // An icon at the card's end.
    in property <image> icon;
    // Dims it and takes no press.
    in property <bool> enabled: true;
    in property <string> unavailable-text: @tr("Unavailable");
    // Whether it is chosen, and whether its mark is a radio rather than a checkbox.
    in property <bool> on;
    in property <bool> radio;

    out property <bool> has-focus: keys.has-focus;

    callback pressed();

    forward-focus: keys;
    horizontal-stretch: 1;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    min-height: row.min-height;
    preferred-height: row.preferred-height;
    opacity: root.enabled ? 1 : 0.5;
    // RadioCard sets radio-button.
    accessible-role: checkbox;
    accessible-label: root.title;
    accessible-description: root.enabled ? root.description : root.unavailable-text;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.pressed();
        }
    }

    Rectangle {
        border-radius: Theme.radius(Radius.lg);
        border-width: 1px;
        border-color: keys.has-focus ? Theme.colors.focus : root.on ? Theme.colors.accent : root.enabled && touch.has-hover ? Theme.colors.border-strong : Theme.colors.border;
        background: Theme.colors.surface;
    }

    row := HorizontalLayout {
        // Inside the 1 px border.
        padding: 17px;
        spacing: 12px;
        // Stretched: the words (`flex_1`) take the room and push the icon to the end.

        VerticalLayout {
            padding-top: 2px;
            alignment: start;

            if !root.radio: CheckMark {
                state: root.on ? CheckState.on : CheckState.off;
                enabled: root.enabled;
            }
            if root.radio: RadioMark {
                on: root.on;
                enabled: root.enabled;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            alignment: start;

            TypeText {
                text: root.title;
                font-size: Theme.text-size(TextSize.base);
                font-weight: 500;
            }

            if root.description != "": VerticalLayout {
                padding-top: 2px;

                TypeText {
                    text: root.description;
                    font-size: Theme.text-size(TextSize.sm);
                    color: Theme.colors.fg-muted;
                }
            }

            VerticalLayout {
                padding-top: preview.preferred-height > 0 ? 8px : 0;

                preview := VerticalLayout {
                    @children
                }
            }
        }

        if root.icon.width > 0: VerticalLayout {
            alignment: start;

            Icon {
                source: root.icon;
                size: IconSize.md;
                color: Theme.colors.fg-muted;
            }
        }
    }

    // A press never takes focus, as gpui prevents default on mouse down.
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.pressed();
        }
    }

    keys := ClickKeys {
        enabled: root.enabled;
        activated => {
            root.pressed();
        }
    }
}

// A card that turns on and off, with a checkbox in its corner.
export component CheckboxCard inherits ChoiceCard {
    in-out property <bool> checked;

    // Runs with the new state on each press.
    callback toggled(on: bool);

    on: root.checked;
    pressed => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
}

// A card chosen from several, with a radio in its corner. Its children are a preview under the
// words, such as what the choice looks like.
export component RadioCard inherits ChoiceCard {
    in-out property <bool> chosen;

    // Chosen while not chosen.
    callback selected();

    on: root.chosen;
    radio: true;
    accessible-role: radio-button;
    pressed => {
        if !root.chosen {
            root.chosen = true;
            root.selected();
        }
    }
}
