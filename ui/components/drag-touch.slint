// gpui's drag start (div.rs `DRAG_THRESHOLD`): a left press turns into a drag once the pointer is
// more than 2 px from where it went down. Until then nothing moves, and a release is a click.
// Positions are in window coordinates, so they hold while the element itself moves.

export component DragTouch inherits TouchArea {
    // A drag is under way.
    out property <bool> dragging: false;
    // The press crossed the threshold; `drag-moved` follows at once with that position.
    callback drag-started();
    // Each pointer position during the drag, the first one included.
    callback drag-moved(x: length, y: length);
    // The left button was let go after a drag.
    callback drag-ended();
    // The left button was let go without a drag.
    callback tapped();

    // Where the left press went down, in window coordinates.
    out property <length> down-x;
    out property <length> down-y;

    pointer-event(event) => {
        if event.button != PointerEventButton.left {
            return;
        }
        if event.kind == PointerEventKind.down {
            root.dragging = false;
            root.down-x = self.absolute-position.x + self.mouse-x;
            root.down-y = self.absolute-position.y + self.mouse-y;
        } else if event.kind == PointerEventKind.up {
            if root.dragging {
                root.dragging = false;
                root.drag-ended();
            } else {
                root.tapped();
            }
        }
    }
    moved => {
        if !self.pressed {
            return;
        }
        let x = self.absolute-position.x + self.mouse-x;
        let y = self.absolute-position.y + self.mouse-y;
        if !root.dragging && Math.sqrt(Math.pow((x - root.down-x) / 1px, 2) + Math.pow((y - root.down-y) / 1px, 2)) > 2 {
            root.dragging = true;
            root.drag-started();
        }
        if root.dragging {
            root.drag-moved(x, y);
        }
    }
}
