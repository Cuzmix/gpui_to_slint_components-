// Port of ely-core/src/forms/files.rs (`DropZone`): a dashed area that takes dropped files;
// Browse opens the system's file dialog instead. While files hover, it tints focus when it takes
// them and danger when not (several on a one-file zone, a folder, a kind it does not take).
//
// The dialog goes through `Paths` (`wire_paths!`, gap G56); checking files through `Files`
// (`wire_files!`), with drops routed by the host (gap G64).

import {
    Theme,
    ControlSize,
    IconSize,
    Radius,
    TextSize,
} from "../theme/theme.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons/icons.slint";
import { Button } from "button.slint";
import { TypeText } from "type-text.slint";
import { Paths } from "path-input.slint";
import { Files, FileDrops, DashedOutline } from "files.slint";

export component DropZone {
    // Names the zone to the dialog and to drops; unique among them.
    in property <string> owner: "drop-zone";
    // A line under the prompt, such as the kinds and sizes taken.
    in property <string> hint;
    // Takes several files at once.
    in property <bool> multiple;
    // Takes only files of these kinds, by extension (such as `Files.pictures`); none takes any.
    in property <[string]> kinds;

    // Files from another app hover it, and whether it takes them.
    out property <bool> drag-over: Files.drag.hovering && Files.drag.owner == root.owner;
    out property <bool> takes-drag: root.drag-over && Files.refusal(Files.drag.paths, root.multiple, root.kinds) == "";

    // The paths dropped or chosen.
    callback dropped(paths: [string]);

    private property <string> what: "drop zone \"" + root.owner + "\"";
    private property <int> answers: Paths.answers;
    private property <int> drops: Files.drag.serial;

    // Takes `paths` when they pass, else logs why not.
    function offer(paths: [string], how: string) {
        let reason = Files.refusal(paths, root.multiple, root.kinds);
        if reason == "" {
            Files.took(root.what, paths.length);
            root.dropped(paths);
        } else {
            Files.refused(root.what, how + ": " + reason);
        }
    }

    changed answers => {
        if Paths.answered-owner == root.owner {
            root.offer(Paths.answered, "a choice");
        }
    }
    changed drops => {
        if Files.drag.dropped && Files.drag.owner == root.owner {
            root.offer(Files.drag.paths, "a drop");
        }
    }

    horizontal-stretch: 1;
    min-width: column.min-width;
    preferred-width: column.preferred-width;
    min-height: column.min-height;
    preferred-height: column.preferred-height;

    Rectangle {
        border-radius: Theme.radius(Radius.lg);
        background: FileDrops.tint-fill(root.drag-over, root.takes-drag);
    }

    DashedOutline {
        width: parent.width;
        height: parent.height;
        radius: Theme.radius(Radius.lg);
        color: root.drag-over ? FileDrops.tint-border(true, root.takes-drag) : Theme.colors.border-strong;
    }

    column := VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 32px;
        padding-bottom: 32px;
        spacing: 8px;
        alignment: start;

        HorizontalLayout {
            alignment: center;

            Icon {
                source: Icons.upload;
                size: IconSize.lg;
                color: Theme.colors.fg-muted;
            }
        }

        TypeText {
            text: root.multiple ? @tr("Drop files here") : @tr("Drop a file here");
            font-size: Theme.text-size(TextSize.base);
            color: Theme.colors.fg;
            horizontal-alignment: center;
        }

        if root.hint != "": TypeText {
            text: root.hint;
            font-size: Theme.text-size(TextSize.sm);
            color: Theme.colors.fg-subtle;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            padding-top: 8px;
            alignment: center;

            Button {
                text: @tr("Browse…");
                size: ControlSize.sm;
                clicked => {
                    Paths.choose({ owner: root.owner, directories: false, multiple: root.multiple, prompt: @tr("Choose") });
                }
            }
        }
    }
}
