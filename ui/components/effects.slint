// Port of ely-core/src/typography/effects.rs (`Typewriter`, `GradientText`, `ShimmerText`).
//
// Splitting graphemes and coloring them one by one needs the host (`TextFormat`, wired by
// `ely_slint::wire_text_format!`). Unwired, the typewriter shows its whole text at once and the
// gradient and shimmer show plain text in their first color.

import { Theme, TextSize } from "../theme/theme.slint";
import { TypeText } from "type-text.slint";
import { TextFormat } from "text-format.slint";

// Colored text on one line box of the ambient leading, glyphs centered in it as gpui sets them.
// Slint's StyledText takes no line height, so wrapped lines keep the face's own spacing (G28).
component TintedText inherits Rectangle {
    in property <styled-text> styled;

    private property <length> line: ceil(1.618034 * Theme.text-size(TextSize.base) / 1phx - 0.5) * 1phx;

    min-width: 0;
    preferred-width: body.preferred-width;
    height: max(root.line, body.preferred-height);

    body := StyledText {
        width: root.width;
        height: root.height;
        text: root.styled;
        default-font-family: Theme.font-family;
        default-font-size: Theme.text-size(TextSize.base);
        default-color: Theme.colors.fg;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Reveals its text one grapheme at a time at `speed` a second, then a blinking caret stays.
export component Typewriter inherits HorizontalLayout {
    in property <string> text;
    // Graphemes a second.
    in property <float> speed: 32;
    // What shows now.
    out property <string> shown-text: root.count > 0 ? TextFormat.grapheme-prefix(root.text, root.shown) : root.text;
    // True while graphemes are still appearing.
    out property <bool> typing: root.running;

    private property <int> count: TextFormat.grapheme-count(root.text);
    private property <duration> reveal: root.speed > 0 ? Theme.duration(root.count / root.speed * 1s) : 0ms;
    private property <duration> started;
    private property <bool> running: false;
    private property <float> progress: root.running && root.reveal > 0 ? clamp((animation-tick() - root.started) / root.reveal, 0, 1) : 1;
    private property <int> shown: min(root.count, ceil(root.count * root.progress));
    private property <length> body: Theme.text-size(TextSize.base);

    function restart() {
        root.started = animation-tick();
        root.running = root.reveal > 0;
    }

    init => {
        root.restart();
    }
    changed text => {
        root.restart();
    }

    spacing: 2px;
    alignment: start;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    TypeText {
        text: root.shown-text;
        vertical-alignment: center;
        accessible-role: none;
    }

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: root.body * 0.15;
            height: root.body * 1.3;
            background: Theme.colors.fg;
            opacity: Theme.reduced-motion ? 1 : Theme.pulsating-between(0.15, 1, Math.mod(animation-tick() / 1ms, 1100) / 1100);
        }
    }

    Timer {
        interval: max(1ms, root.reveal);
        running: root.running;
        triggered => {
            root.running = false;
        }
    }
}

// A tonal ramp across the glyphs, ink to muted unless given its ends.
export component GradientText {
    in property <string> text;
    in property <color> from: Theme.colors.fg;
    in property <color> to: Theme.colors.fg-subtle;

    private property <bool> wired: TextFormat.grapheme-count("x") == 1;

    min-width: 0;
    preferred-width: root.wired ? tinted.preferred-width : plain.preferred-width;
    height: root.wired ? tinted.height : plain.preferred-height;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    tinted := TintedText {
        visible: root.wired;
        width: root.width;
        styled: TextFormat.gradient(root.text, root.from, root.to);
    }

    plain := TypeText {
        visible: !root.wired;
        width: root.width;
        text: root.text;
        color: root.from;
        accessible-role: none;
    }
}

// A band of light that sweeps the text every 1.8 s while it waits; still and dim under
// reduced motion.
export component ShimmerText {
    in property <string> text;

    private property <bool> moving: !Theme.reduced-motion && TextFormat.grapheme-count("x") == 1;

    min-width: 0;
    preferred-width: root.moving ? tinted.preferred-width : plain.preferred-width;
    height: root.moving ? tinted.height : plain.preferred-height;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    tinted := TintedText {
        visible: root.moving;
        width: root.width;
        styled: root.moving ? TextFormat.shimmer(root.text, Theme.colors.fg-subtle, Theme.colors.fg, Math.mod(animation-tick() / 1ms, 1800) / 1800) : TextFormat.gradient("", Theme.colors.fg, Theme.colors.fg);
    }

    plain := TypeText {
        visible: !root.moving;
        width: root.width;
        text: root.text;
        color: Theme.colors.fg-subtle;
        accessible-role: none;
    }
}
