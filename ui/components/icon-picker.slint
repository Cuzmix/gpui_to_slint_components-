// Port of ely-core/src/forms/glyphs.rs (`IconPicker`): a searchable grid of the library's
// icons, eight across. A search finds icons whose name (dashes read as spaces) holds it.
//
// The grid needs `wire_glyphs!` and `wire_fields!`. Like Select (G48), `selected` is `in-out`:
// a pick sets it, then reports it.

import { Icons } from "../icons/icons.slint";
import { GlyphGrid, Glyphs } from "glyph-grid.slint";

export component IconPicker {
    // Names it in the log.
    in property <string> owner: "icon";
    // The icon chosen, by name ("star"); empty for none.
    in-out property <string> selected;

    // The search text.
    out property <string> text: grid.text;
    out property <int> cursor: grid.cursor;

    // The icon picked, by name; `Icons.all` holds its image.
    callback selection-changed(name: string);

    forward-focus: grid;
    min-width: grid.min-width;
    max-width: grid.max-width;
    min-height: grid.min-height;
    max-height: grid.max-height;

    grid := GlyphGrid {
        icons: true;
        layout: Glyphs.icon-layout(Icons.all, self.text);
        selected: Glyphs.index-of(self.layout.names, root.selected);
        placeholder: @tr("Search icons");
        none: @tr("No icons match");
        picked(ix) => {
            root.selected = self.layout.names[ix];
            Glyphs.picked("icon picker \"" + root.owner + "\"", root.selected);
            root.selection-changed(root.selected);
        }
    }
}
