// Port of ely-core/src/primitives/measure.rs (`Measure`, `IntersectionObserver`).

// A box that reports its bounds in window coordinates whenever they change.
// It lays its children out top to bottom and takes their size, as GPUI's div does.
export component Measure inherits VerticalLayout {
    // x, y, width, height of this box in the window.
    callback measured(length, length, length, length);

    private property <Point> at: self.absolute-position;

    changed at => {
        root.measured(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
    }
    changed width => {
        root.measured(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
    }
    changed height => {
        root.measured(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
    }
    init => {
        root.measured(self.absolute-position.x, self.absolute-position.y, self.width, self.height);
    }

    @children
}

// A box that reports when it enters or leaves the visible area.
// GPUI reads the clip it paints under; Slint does not expose it, so the owner passes the
// visible area (for example a Flickable's viewport) in window coordinates.
// It lays its children out top to bottom and takes their size.
export component IntersectionObserver inherits VerticalLayout {
    in property <length> visible-x;
    in property <length> visible-y;
    in property <length> visible-width;
    in property <length> visible-height;

    out property <bool> in-view: self.absolute-position.x < visible-x + visible-width && self.absolute-position.x + self.width > visible-x && self.absolute-position.y < visible-y + visible-height && self.absolute-position.y + self.height > visible-y;

    // True when it comes into view, false when it leaves.
    callback visibility-changed(bool);

    changed in-view => {
        root.visibility-changed(self.in-view);
    }
    init => {
        root.visibility-changed(self.in-view);
    }

    @children
}
