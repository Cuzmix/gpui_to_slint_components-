// Port of ely-core/src/forms/options.rs: `Choice`, `option_row`, `surface`, `float` and
// `Popup`, the floating list that search fields, selects and comboboxes share.
//
// The list floats over everything while focus stays in the field that opened it, so a field can
// keep its caret and take typing. A Slint PopupWindow takes keyboard focus while open (gap G54),
// so the list is drawn by one `OptionLayer` that the window puts last, as it does a Backdrop
// (gap G12). A field shows it through an `OptionAnchor`, which hands the rows to the layer
// through the `OptionFloat` global and reports picks back:
//     Window {
//         ...the window's content...
//         OptionLayer { }
//     }
// Only one list shows at a time: the anchor that opened last.

import {
    Theme,
    ControlSize,
    Elevation,
    IconSize,
    Radius,
    TextSize,
} from "../theme/theme.slint";
import { Elevated } from "elevated.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons/icons.slint";
import { Ellipsis } from "ellipsis.slint";
import { Toggles } from "button-group.slint";

// One option: a value, the label shown for it, and an optional icon and note.
export struct Choice {
    // What a pick reports.
    value: string,
    // What the row shows.
    label: string,
    // An icon before the label.
    icon: image,
    // A name whose initials lead the row (drawn once Avatar lands, chapter 12).
    avatar: string,
    // Quiet text at the row's end.
    note: string,
    // Shown but not pickable.
    disabled: bool,
    // How far it sits under a parent.
    depth: int,
}

// What the list needs from Rust: Slint cannot walk an array (`ely_slint::options`).
export global Choices {
    // The next row from `from` that is not disabled, stepping by `by` and wrapping.
    pure callback step(rows: [Choice], from: int, by: int) -> int;
    // Rows whose value and label are each of `labels`.
    pure callback plain(labels: [string]) -> [Choice];
    // Rows whose label or note holds `query`, ignoring case (all for an empty query), less those
    // whose value is in `except`.
    pure callback matching(rows: [Choice], query: string, except: [string]) -> [Choice];
    // The label of the row holding `value`; `value` when none does.
    pure callback label-of(rows: [Choice], value: string) -> string;
    // `values` with `value` appended (unless empty or there already), or without the one at
    // `index`.
    pure callback with(values: [string], value: string) -> [string];
    pure callback without(values: [string], index: int) -> [string];
    // A tag field's word: trimmed, a trailing comma dropped; and whether the text ends with a
    // comma outside quotes.
    pure callback tag-word(text: string) -> string;
    pure callback comma-ends(text: string) -> bool;
    // `selected` with `value` turned on or off, in the order of `choices` (CheckboxGroup).
    // The rows whose value is among `values`, in row order; and rows' labels joined by ", ".
    pure callback among(rows: [Choice], values: [string]) -> [Choice];
    pure callback joined(rows: [Choice]) -> string;
    // The index of the row holding `value`; -1 when none does.
    pure callback index-of(rows: [Choice], value: string) -> int;
    pure callback toggled(choices: [Choice], selected: [string], value: string, on: bool) -> [string];
}

// One row: a check column when `checks`, then indent, icon, label and note.
export component OptionRow {
    in property <Choice> choice;
    in property <bool> highlighted;
    // Whether the row has a check column, and whether it is checked.
    in property <bool> checks;
    in property <bool> checked;
    in property <string> unavailable-text: @tr("Unavailable");

    callback picked();

    private property <color> fg: root.choice.disabled ? Theme.colors.fg-disabled : Theme.colors.fg;

    accessible-role: list-item;
    accessible-label: root.choice.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.checks && root.checked;
    accessible-description: root.choice.disabled ? root.unavailable-text : "";
    accessible-action-default => {
        if !root.choice.disabled {
            root.picked();
        }
    }

    Rectangle {
        border-radius: Theme.radius(Radius.md);
        background: !root.choice.disabled && (root.highlighted || touch.has-hover) ? Theme.colors.hover : transparent;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;
        cross-axis-alignment: center;

        if root.checks: Rectangle {
            width: Theme.icon-size(IconSize.sm);
            height: self.width;

            if root.checked: Icon {
                source: Icons.check;
                size: IconSize.sm;
                color: root.fg;
            }
        }

        if root.choice.depth > 0: Rectangle {
            width: Theme.tree-indent * root.choice.depth;
        }

        if root.choice.icon.width > 0: Icon {
            source: root.choice.icon;
            size: IconSize.sm;
            color: Theme.colors.fg-muted;
        }

        Ellipsis {
            horizontal-stretch: 1;
            text: root.choice.label;
            font-size: Theme.text-size(TextSize.sm);
            color: root.fg;
        }

        if root.choice.note != "": Text {
            text: root.choice.note;
            color: Theme.colors.fg-subtle;
            font-size: Theme.text-size(TextSize.sm);
            font-family: Theme.font-family;
            vertical-alignment: center;
        }
    }

    // A press picks and leaves focus where it was, as gpui's prevented mouse down does.
    touch := TouchArea {
        enabled: !root.choice.disabled;
        mouse-cursor: MouseCursor.pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.picked();
            }
        }
    }
}

// The card a floating list sits on: radius lg, overlay fill, a hairline, the floating shadow.
export component OptionSurface inherits Elevated {
    elevation: Elevation.floating;
    border-radius: Theme.radius(Radius.lg);
    background: Theme.colors.overlay;
    border-width: 1px;
    border-color: Theme.colors.border;
}

// The one list on screen: who shows it, what it holds, and where its field is.
export global OptionFloat {
    // The id of the anchor showing the list; empty while none does.
    in-out property <string> owner;
    in-out property <[Choice]> rows;
    in-out property <int> highlighted: -1;
    in-out property <bool> checks;
    in-out property <[string]> checked;
    // The field's box, in window coordinates.
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-width;
    in-out property <length> anchor-height;
    // Counts the lists opened, so each opening rises in.
    in-out property <int> opened;
    // A press outside the list closes it; counted so the owner sees each one.
    in-out property <bool> dismissable;
    in-out property <int> dismissals;
    // The last pick, and a count of picks so the owner sees each one.
    in-out property <int> picked: -1;
    in-out property <int> picks;
}

// What a field puts inside itself, outside any layout, to show the list under its own box.
export component OptionAnchor {
    // Names the field; unique among the fields that show lists.
    in property <string> owner;
    in property <bool> open;
    in property <[Choice]> rows;
    // Plain rows instead, each value its own label (through `Choices.plain`, read when the list
    // shows: a binding to it would be read before the host wires `Choices`).
    in property <[string]> labels;
    // The row the keys point at; -1 for none.
    in property <int> highlighted: -1;
    // A check column, checked for `checked` values.
    in property <bool> checks;
    in property <[string]> checked;
    // A press outside the list asks to close it. It does not reach what lies under it (G54).
    in property <bool> dismissable;

    // The row at `index` was pressed.
    callback picked(index: int);
    // A press landed outside the list.
    callback dismissed();

    out property <bool> showing: root.open && OptionFloat.owner == root.owner;

    // It takes its parent's box: the list floats under that.
    x: 0;
    y: 0;
    width: 100%;
    height: 100%;

    private property <Point> at: self.absolute-position;
    private property <int> picks: OptionFloat.picks;
    private property <int> dismissals: OptionFloat.dismissals;

    function claim() {
        OptionFloat.rows = root.labels.length > 0 ? Choices.plain(root.labels) : root.rows;
        OptionFloat.highlighted = root.highlighted;
        OptionFloat.checks = root.checks;
        OptionFloat.checked = root.checked;
        OptionFloat.dismissable = root.dismissable;
        OptionFloat.anchor-x = root.absolute-position.x;
        OptionFloat.anchor-y = root.absolute-position.y;
        OptionFloat.anchor-width = root.width;
        OptionFloat.anchor-height = root.height;
        if OptionFloat.owner != root.owner {
            OptionFloat.owner = root.owner;
            OptionFloat.opened += 1;
        }
    }

    function sync() {
        if root.open {
            root.claim();
        } else if OptionFloat.owner == root.owner {
            OptionFloat.owner = "";
        }
    }

    init => {
        root.sync();
    }
    changed open => {
        root.sync();
    }
    changed rows => {
        root.sync();
    }
    changed labels => {
        root.sync();
    }
    changed highlighted => {
        root.sync();
    }
    changed checked => {
        root.sync();
    }
    changed at => {
        root.sync();
    }
    changed width => {
        root.sync();
    }
    changed picks => {
        if OptionFloat.owner == root.owner && root.open {
            root.picked(OptionFloat.picked);
        }
    }
    changed dismissals => {
        if OptionFloat.owner == root.owner && root.open {
            root.dismissed();
        }
    }
}

// Draws the open list. Put it last in the window, filling it.
export component OptionLayer {
    // Whether a list is on screen.
    out property <bool> shown: OptionFloat.owner != "";
    // How far its entrance has run, 0 to 1.
    out property <float> entrance: root.rise;
    // Whether it opened over its field, for want of room below.
    out property <bool> up: root.list-height > root.below && OptionFloat.anchor-y > root.below;

    x: 0;
    y: 0;
    width: 100%;
    height: 100%;

    private property <length> below: root.height - OptionFloat.anchor-y - OptionFloat.anchor-height;
    // gpui's guess at the list's height, for the side it opens to: a md row per option, and one.
    private property <length> list-height: min(Theme.control-height(ControlSize.md) * (OptionFloat.rows.length + 1), Theme.list-max-height);
    private property <int> opened: OptionFloat.opened;
    private property <duration> entered-at;
    private property <bool> rising;
    private property <float> rise: root.rising ? Theme.ease-out-cubic(clamp((animation-tick() - root.entered-at) / Theme.motion-fast, 0, 1)) : 1;

    changed opened => {
        root.entered-at = animation-tick();
        root.rising = true;
        risen.running = true;
        risen.restart();
    }

    risen := Timer {
        interval: Theme.motion-fast;
        running: false;
        triggered => {
            self.running = false;
            root.rising = false;
        }
    }

    if root.shown && OptionFloat.dismissable: TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                OptionFloat.dismissals += 1;
            }
        }
    }

    if root.shown: list := OptionSurface {
        property <length> least: OptionFloat.anchor-width > 0 ? OptionFloat.anchor-width : Theme.tooltip-max-width;
        property <length> most: max(0, root.width - Theme.window-margin * 2);
        property <length> gap: Theme.nudge * (2 - root.rise);

        // Kept inside the window, as gpui's `snap_to_window`.
        x: max(0, min(OptionFloat.anchor-x, root.width - self.width));
        y: root.up ? OptionFloat.anchor-y - self.height - self.gap : OptionFloat.anchor-y + OptionFloat.anchor-height + self.gap;
        width: min(self.most, max(self.least, column.preferred-width + 10px));
        height: min(Theme.list-max-height, column.preferred-height + 10px);
        opacity: root.rise;
        clip: true;
        accessible-role: AccessibleRole.list;

        // Presses inside never reach what lies under the list.
        TouchArea { }

        flick := Flickable {
            // Inside the hairline, 4 px in.
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            height: parent.height - 10px;
            content-height: column.preferred-height;

            column := VerticalLayout {
                for choice[ix] in OptionFloat.rows: OptionRow {
                    choice: choice;
                    highlighted: ix == OptionFloat.highlighted;
                    checks: OptionFloat.checks;
                    checked: OptionFloat.checks && Toggles.contains(OptionFloat.checked, choice.value);
                    picked => {
                        OptionFloat.picked = ix;
                        OptionFloat.picks += 1;
                    }
                    // Keeps the highlighted row in view.
                    changed highlighted => {
                        if self.highlighted {
                            if self.y < -flick.content-y {
                                flick.content-y = -self.y;
                            } else if self.y + self.height > -flick.content-y + flick.height {
                                flick.content-y = -(self.y + self.height - flick.height);
                            }
                        }
                    }
                }
            }
        }
    }
}
