// Port of ely-core/src/typography/text.rs (`Paragraph`).
// Reading text. Loose leading.

import { Theme, TextSize } from "../theme/theme.slint";
import { TypeText } from "type-text.slint";

export component Paragraph inherits TypeText {
    font-size: Theme.text-size(TextSize.md);
    font-weight: 400;
    color: Theme.colors.fg;
    leading: 1.6;
}
