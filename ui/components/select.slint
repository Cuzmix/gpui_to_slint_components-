// Port of ely-core/src/forms/select.rs (`Select`, `listing`): a button that opens a list and
// shows the one chosen. A press toggles the list; Down, Up, Enter or Space open it; while open
// Up, Down, Home and End walk it past disabled rows, Enter or Space picks, and Escape, a press
// outside or leaving the field closes it.
//
// The list needs `wire_options!` and an `OptionLayer` (options.slint). Like ToggleGroup (G48),
// `selected` is `in-out`: a pick sets it, then reports it.

import { Theme, ControlSize, IconSize } from "../theme/theme.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons/icons.slint";
import { Choice, Choices, OptionAnchor } from "options.slint";
import { FieldButton, FieldText } from "field-button.slint";

// What a list opener does with keys: a new open state and row, or nothing for keys it leaves.
export struct ListMove {
    taken: bool,
    open: bool,
    highlighted: int,
    // Enter or Space on an open list: pick `highlighted`.
    pick: bool,
}

// The keys of `listing`: closed, Down, Up, Enter or Space open at `start`; open, Up, Down, Home
// and End walk, Enter or Space pick, Escape closes.
export global ListKeys {
    public pure function moved(event: KeyEvent, rows: [Choice], open: bool, at: int, start: int) -> ListMove {
        if !open {
            return event.text == Key.DownArrow || event.text == Key.UpArrow || event.text == Key.Return || event.text == " " ? { taken: true, open: true, highlighted: start } : { taken: false };
        }
        if event.text == Key.DownArrow {
            return { taken: true, open: true, highlighted: Choices.step(rows, at, 1) };
        }
        if event.text == Key.UpArrow {
            return { taken: true, open: true, highlighted: Choices.step(rows, at, -1) };
        }
        if event.text == Key.Home {
            return { taken: true, open: true, highlighted: Choices.step(rows, rows.length - 1, 1) };
        }
        if event.text == Key.End {
            return { taken: true, open: true, highlighted: Choices.step(rows, 0, -1) };
        }
        if event.text == Key.Return || event.text == " " {
            return { taken: true, open: true, highlighted: at, pick: true };
        }
        if event.text == Key.Escape {
            return { taken: true, open: false, highlighted: at };
        }
        { taken: false }
    }
}

export component Select {
    // Names the field's list; unique among the fields that show lists.
    in property <string> owner: "select";
    in property <[Choice]> choices;
    // The value chosen; empty for none.
    in-out property <string> selected;
    // What it shows with nothing chosen.
    in property <string> placeholder: @tr("Choose…");
    // The name assistive technology reads; the placeholder when empty.
    in property <string> label;
    // Its height and text size.
    in property <ControlSize> size: ControlSize.md;
    // Dims it and takes no press.
    in property <bool> enabled: true;
    in property <string> unavailable-text: @tr("Unavailable");

    out property <bool> has-focus: button.has-focus;
    out property <bool> open;
    out property <int> highlighted;

    // The value picked.
    callback selection-changed(value: string);

    private property <int> current: Choices.index-of(root.choices, root.selected);
    private property <Choice> shown: root.current >= 0 ? root.choices[root.current] : { };
    // Where the cursor starts: the choice, else the first enabled row.
    private property <int> start: root.current >= 0 ? root.current : Choices.step(root.choices, root.choices.length - 1, 1);

    function show(open: bool, at: int) {
        root.open = open && root.enabled && root.choices.length > 0;
        root.highlighted = at;
    }

    function pick(ix: int) {
        if root.choices[ix].disabled {
            return;
        }
        root.show(false, ix);
        root.selected = root.choices[ix].value;
        root.selection-changed(root.selected);
    }

    changed has-focus => {
        if !root.has-focus {
            root.open = false;
        }
    }

    forward-focus: button;
    horizontal-stretch: 1;
    min-width: button.min-width;
    preferred-width: button.preferred-width;
    height: button.height;
    accessible-role: combobox;
    accessible-label: root.label != "" ? root.label : root.placeholder;
    accessible-placeholder-text: root.placeholder;
    accessible-value: root.shown.label;
    accessible-description: root.enabled ? "" : root.unavailable-text;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => {
        root.show(!root.open, root.start);
    }

    button := FieldButton {
        width: root.width;
        size: root.size;
        enabled: root.enabled;
        pressed => {
            root.show(!root.open, root.start);
        }
        key-pressed(event) => {
            let move = ListKeys.moved(event, root.choices, root.open, root.highlighted, root.start);
            if !move.taken {
                return reject;
            }
            if move.pick {
                root.pick(move.highlighted);
            } else {
                root.show(move.open, move.highlighted);
            }
            accept
        }

        if root.shown.icon.width > 0: Icon {
            source: root.shown.icon;
            size: IconSize.sm;
            color: Theme.colors.fg-muted;
        }

        FieldText {
            text: root.shown.label;
            placeholder: root.placeholder;
            size: root.size;
            enabled: root.enabled;
        }

        VerticalLayout {
            alignment: center;

            Icon {
                source: Icons.chevrons-up-down;
                size: IconSize.xs;
                color: Theme.colors.fg-subtle;
            }
        }
    }

    OptionAnchor {
        owner: root.owner;
        open: root.open;
        rows: root.choices;
        highlighted: root.highlighted;
        checks: true;
        checked: root.current >= 0 ? [root.selected] : [];
        dismissable: true;
        picked(ix) => {
            root.pick(ix);
        }
        dismissed => {
            root.open = false;
        }
    }
}
