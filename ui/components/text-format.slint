// The text work `.slint` cannot do on its own: parsing key syntax, cutting text to fit,
// finding matches, formatting numbers and dates, splitting graphemes and coloring them. Each
// is a pure callback the host wires once to `ely_slint` (Rust):
//
//     ely_slint::wire_text_format!(app);
//
// The host exports `TextFormat`, `PlatformStyle` and `RollCell` from its root `.slint` file.
// Unwired, each callback returns an empty value and its component falls back to a plain
// rendering, noted where the component is.

import { PlatformStyle } from "../theme/theme.slint";

// One place of a rolling number: the character it leaves and the one it lands on.
export struct RollCell {
    from: string,
    to: string,
}

export global TextFormat {
    // The caps of one keystroke in gpui key syntax (`secondary-s`), modifiers first in the
    // platform's order: ⌘ and S on the Mac, Ctrl and S elsewhere. Empty if it does not parse.
    pure callback key-labels(source: string, platform: PlatformStyle) -> [string];
    // The caps of each chord in a space-separated sequence (`cmd-k cmd-s`).
    pure callback key-chords(source: string, platform: PlatformStyle) -> [[string]];
    // Every cut of `text` at the end with an ellipsis, shortest first, each once.
    pure callback end-cuts(text: string) -> [string];
    // Every cut of `text` in the middle with an ellipsis, shortest first, each once.
    pure callback middle-cuts(text: string) -> [string];
    // `text` split into runs that alternate plain and marked, first plain, marking every
    // case-insensitive match of `query`.
    pure callback highlight-runs(text: string, query: string) -> [string];
    // Grouped digits at fixed precision with a typographic minus: 1,234.50, −3.
    pure callback number(value: float, decimals: int) -> string;
    // An amount in an ISO 4217 currency, at its minor units: $19.99, ¥1,200, CHF 5.00.
    pure callback currency(amount: float, code: string) -> string;
    // A ratio as percent: 0.25 reads 25.0%; `signed` adds a plus to gains.
    pure callback percent(ratio: float, decimals: int, signed: bool) -> string;
    // Bytes in KB, MB, GB (1000), or KiB, MiB, GiB (1024) when `binary`.
    pure callback file-size(bytes: float, binary: bool) -> string;
    // Unix seconds as a strftime pattern in a zone (an IANA name; empty is the system's).
    // Empty if the pattern or zone does not read.
    pure callback datetime(at: int, pattern: string, zone: string) -> string;
    // The emoji a GitHub shortcode names ("tada" is 🎉); empty if unknown.
    pure callback emoji(shortcode: string) -> string;
    // How many grapheme clusters `text` holds, as a reader counts letters.
    pure callback grapheme-count(text: string) -> int;
    // The first `count` grapheme clusters of `text`.
    pure callback grapheme-prefix(text: string, count: int) -> string;
    // `text` with each grapheme blended from `from` at the first to `to` at the last.
    pure callback gradient(text: string, from: color, to: color) -> styled-text;
    // `text` in `dim` with a band a quarter of the line wide lighting it toward `lit`, the band
    // at loop position `t` (0 to 1) sweeping from -0.3 to 1.3.
    pure callback shimmer(text: string, dim: color, lit: color, t: float) -> styled-text;
    // AnimatedNumber's text: grouped, `decimals` places, zero-padded to `pad` after the minus.
    pure callback rolling-text(value: float, decimals: int, pad: int) -> string;
    // Two rolling texts right-aligned by place, a character per cell.
    pure callback roll-cells(from: string, to: string) -> [RollCell];
}
