// Port of ely-core/src/primitives/tooltip.rs (`Tooltip`, `TooltipTrigger`) and of the
// show/hide rules of GPUI's own `.tooltip()` (gpui elements/div.rs):
// - shows `delay` after the pointer first moves over the host (GPUI default 500 ms),
//   at the pointer position plus 1 px, its body 18 px (cursor-offset) below;
// - hides when the pointer leaves, on any mouse down, and on scroll;
// - fades in and rises 4 px over 120 ms with ease-out-cubic.
//
// Slint has no hover-tooltip hook, so the host feeds pointer events in:
//     tip := TooltipController { text: "Close"; }
//     TouchArea {
//         pointer-event(e) => { tip.pointer-event(e, self.mouse-x, self.mouse-y); }
//         scroll-event(e) => { tip.dismiss(); reject }
//         changed has-hover => { if !self.has-hover { tip.dismiss(); } }
//     }
// Place the controller at the host's origin (it has no size).

import {
    Theme,
    Elevation,
    Radius,
    TextSize,
    IconSize,
} from "../theme/theme.slint";
import { Elevated } from "elevated.slint";
import { Icon } from "icon.slint";
import { Icons } from "../icons/icons.slint";

// The body every tooltip draws: title, and an optional quiet trailing hint;
// or, when `rich`, its children (`Tooltip::rich`).
export component TooltipSurface inherits Elevated {
    in property <string> text;
    in property <string> meta;
    // Draws the children in place of text and meta.
    in property <bool> rich: false;
    // 0..1 entrance progress, linear; eased here.
    in property <float> progress: 1.0;
    private property <float> eased: Theme.ease-out-cubic(progress);

    elevation: Elevation.floating;
    border-radius: Theme.radius(Radius.md);
    background: Theme.colors.tooltip-bg;
    opacity: eased;
    max-width: Theme.tooltip-max-width;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        alignment: start;
        // Empty unless the owner gives children.
        VerticalLayout {
            @children
        }

        if !root.rich: HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.text;
                color: Theme.colors.tooltip-fg;
                font-size: Theme.text-size(TextSize.sm);
                font-family: Theme.font-family;
                wrap: word-wrap;
                vertical-alignment: center;
            }

            if root.meta != "": Text {
                text: root.meta;
                color: Theme.opacity(Theme.colors.tooltip-fg, 0.6);
                font-size: Theme.text-size(TextSize.sm);
                font-family: Theme.font-family;
                vertical-alignment: center;
            }
        }
    }
}

export component TooltipController {
    // What the tip reads; empty shows nothing.
    in property <string> text;
    // A quiet trailing hint, such as a shortcut.
    in property <string> meta;
    // Shows the children in the tip in place of text and meta.
    in property <bool> rich: false;
    // How long the pointer rests before the tip shows.
    in property <duration> delay: 500ms;
    // Moves the tip with the pointer.
    in property <bool> follow-mouse: false;
    // gpui's own tooltips sit 1 px off the pointer; TooltipTrigger's sit on it.
    in property <length> nudge: 1px;
    // Whether the tip is on screen.
    out property <bool> shown: false;

    width: 0;
    height: 0;

    private property <bool> pending: false;
    private property <length> mouse-x;
    private property <length> mouse-y;
    private property <length> at-x;
    private property <length> at-y;

    // Feed every pointer event of the host's TouchArea, with its mouse-x and mouse-y.
    public function pointer-event(event: PointerEvent, x: length, y: length) {
        mouse-x = x;
        mouse-y = y;
        if event.kind == PointerEventKind.down {
            dismiss();
        } else if event.kind == PointerEventKind.move {
            if shown {
                if follow-mouse {
                    at-x = x;
                    at-y = y;
                }
            } else if !pending && (text != "" || rich) {
                pending = true;
            }
        }
    }

    // Starts the delay at once, as `TooltipTrigger` does when the pointer enters.
    public function arm(x: length, y: length) {
        mouse-x = x;
        mouse-y = y;
        if !shown && (text != "" || rich) {
            pending = true;
        }
    }

    // Tracks the pointer; a following tip moves with it.
    public function track(x: length, y: length) {
        mouse-x = x;
        mouse-y = y;
        if shown && follow-mouse {
            at-x = x;
            at-y = y;
        }
    }

    // Hides the tip and cancels a pending show: pointer left, pressed or scrolled.
    public function dismiss() {
        pending = false;
        if shown {
            shown = false;
            popup.close();
        }
    }

    Timer {
        interval: root.delay;
        running: root.pending;
        triggered => {
            root.pending = false;
            root.at-x = root.mouse-x;
            root.at-y = root.mouse-y;
            root.shown = true;
            popup.show();
        }
    }

    popup := PopupWindow {
        x: root.at-x + root.nudge;
        y: root.at-y + root.nudge;
        close-policy: PopupClosePolicy.no-auto-close;

        property <float> entered: 0;
        animate entered { duration: Theme.motion-fast; }
        init => {
            self.entered = 1;
        }
        Rectangle {
            width: body.preferred-width;
            height: body.preferred-height + Theme.cursor-offset;
            body := TooltipSurface {
                x: 0;
                y: Theme.cursor-offset + Theme.nudge * (1 - Theme.ease-out-cubic(popup.entered));
                width: self.preferred-width;
                height: self.preferred-height;
                text: root.text;
                meta: root.meta;
                rich: root.rich;
                progress: popup.entered;
                @children
            }
        }
    }
}

// A help mark, ?, whose tip shows on hover (`HelpTooltip`).
export component HelpTooltip {
    // What the tip reads.
    in property <string> text;
    // Whether the tip is on screen.
    out property <bool> shown: tip.shown;

    width: mark.width;
    height: mark.height;
    accessible-role: none;

    mark := Icon {
        source: Icons.circle-help;
        size: IconSize.xs;
        color: Theme.colors.fg-subtle;
    }

    tip := TooltipController {
        x: 0;
        y: 0;
        text: root.text;
    }

    TouchArea {
        pointer-event(event) => {
            tip.pointer-event(event, self.mouse-x, self.mouse-y);
        }
        scroll-event(event) => {
            tip.dismiss();
            reject
        }
        changed has-hover => {
            if !self.has-hover {
                tip.dismiss();
            }
        }
    }
}

// A tooltip with its own delay, and optional cursor tracking (`TooltipTrigger`).
// Wraps its children; the delay starts when the pointer enters, and a press hides the tip.
export component TooltipTrigger inherits VerticalLayout {
    in property <string> text;
    in property <string> meta;
    // How long the pointer rests before the tip shows.
    in property <duration> delay: 400ms;
    // Moves the tip with the pointer.
    in property <bool> follow-mouse: false;
    out property <bool> shown: tip.shown;

    area := TouchArea {
        tip := TooltipController {
            x: 0;
            y: 0;
            text: root.text;
            meta: root.meta;
            delay: root.delay;
            follow-mouse: root.follow-mouse;
            nudge: 0;
        }

        changed has-hover => {
            if self.has-hover {
                tip.arm(self.mouse-x, self.mouse-y);
            } else {
                tip.dismiss();
            }
        }
        changed mouse-x => {
            tip.track(self.mouse-x, self.mouse-y);
        }
        changed mouse-y => {
            tip.track(self.mouse-x, self.mouse-y);
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                tip.dismiss();
            }
        }
        VerticalLayout {
            @children
        }
    }
}
