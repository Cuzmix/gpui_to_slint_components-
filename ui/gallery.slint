// The Ely gallery: one page per chapter, after crates/ely-gallery (stories.json).

import { Theme, Mode, TextSize } from "theme/theme.slint";
import { ThemeFader } from "theme/fader.slint";
import { Button, ButtonVariant } from "components/button.slint";
import { ButtonsPage } from "gallery/pages/buttons.slint";
import { PrimitivesPage } from "gallery/pages/primitives.slint";
import { TypographyPage } from "gallery/pages/typography.slint";
import { LayoutPage } from "gallery/pages/layout.slint";
import { ShellPage } from "gallery/pages/shell.slint";
import { FormsPage } from "gallery/pages/forms.slint";
import { OptionLayer } from "components/options.slint";
import { WindowSwitcher } from "components/window-switcher.slint";
import { WindowTab } from "components/tab-bar.slint";
import { Sheet, Drawer } from "components/sheet.slint";
import { FloatingPanel } from "components/floating-panel.slint";
import { Paragraph } from "components/paragraph.slint";
import { Caption } from "components/caption.slint";
import { Tile } from "gallery/kit.slint";
import { Backdrop } from "components/backdrop.slint";
import { ActionSheet } from "components/action-sheet.slint";
import { Elevated } from "components/elevated.slint";
import { Elevation, Radius } from "theme/theme.slint";
// The Forms page's Rust globals (wire.rs `wire_forms_page`).
export { Cascades, CascadeNode } from "components/cascade-select.slint";
export { Catalogs } from "components/catalogs.slint";
export { Choices, Choice } from "components/options.slint";
export {
    Colors,
    ParsedColor,
    ColorSample,
    Hsva,
} from "components/colors.slint";
export { Crons, CronReading } from "components/cron-editor.slint";
export { Dates, CivilDate, CivilTime, IsoWeek } from "components/dates.slint";
export { FieldRows, KeyValue } from "components/field-array.slint";
export { Files, FileDrag } from "components/files.slint";
export { FormDemo } from "gallery/pages/forms-structure.slint";
export { Forms } from "components/forms.slint";
export {
    Formulas,
    FormulaResult,
    FormulaVariable,
} from "components/expression-input.slint";
export { Glyphs, GlyphLayout, GlyphRow } from "components/glyph-grid.slint";
export {
    Gradients,
    GradientEdit,
    GradientStop,
} from "components/gradient-editor.slint";
export {
    Mentions,
    MentionAt,
    MentionTrigger,
} from "components/mention-input.slint";
export { Numbers, ParsedNumber } from "components/number-input.slint";
export { Paths, PathRequest } from "components/path-input.slint";
export { Signatures, PenPoint } from "components/signature-pad.slint";
export { TextFields, TextFit } from "components/text-field.slint";
export { TimeZones } from "components/timezone-select.slint";
export {
    RelativeRanges,
    DateSpan,
} from "components/relative-date-picker.slint";
export { FocusSteps } from "components/focus-trap.slint";
export { Toggles } from "components/button-group.slint";
export { Sharing } from "components/share-button.slint";
export { TextFormat, RollCell } from "components/text-format.slint";
export { Links } from "components/link.slint";
export { Clock } from "components/value-text.slint";
export { PlatformStyle } from "theme/theme.slint";
export { LayoutMath, MasonrySpot } from "components/layout-math.slint";
export {
    Docks,
    DockSide,
    DockTab,
    DockEdge,
    DockFloatSpot,
    PaneGroups,
    PaneSpan,
    PaneCell,
    PaneDivider,
} from "components/workspace-model.slint";
export { Icons, IconEntry } from "icons/icons.slint";
export {
    WindowChrome,
    ResizeEdge,
    ChromeStyle,
} from "components/window-chrome.slint";
export {
    ColumnShells,
    ShellColumnSpec,
    ShellRoom,
    ShellColumnFrame,
} from "components/column-shell.slint";
export { ManagedWindows } from "components/window-switcher.slint";
export { MiniWindowActs } from "components/mini-window.slint";
export { WindowTab } from "components/tab-bar.slint";
export {
    AboutWindow,
    SplashWindow,
    UpdateWindow,
    CrashWindow,
    DraftWindow,
    MiniPlayer,
    PipWindow,
} from "gallery/windows.slint";
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";

export struct GalleryPage {
    number: int,
    slug: string,
    title: string,
    summary: string,
}

export component Gallery inherits Window {
    title: "Ely gallery";
    preferred-width: 1100px;
    preferred-height: 760px;
    background: Theme.colors.bg;
    default-font-family: Theme.font-family;

    in-out property <[GalleryPage]> pages: [
        {
            number: 1,
            slug: "primitives",
            title: "Primitives",
            summary: "The smallest parts. Most are gpui itself; Ely adds the rest."
        },
        {
            number: 2,
            slug: "typography",
            title: "Typography",
            summary: "Inter for words, tabular figures for numbers, one ink for everything."
        },
        {
            number: 3,
            slug: "layout",
            title: "Layout",
            summary: "Stacks, grids, splits, docks. Structure that stays out of the way."
        },
        {
            number: 4,
            slug: "shell",
            title: "Window & Shell",
            summary: "Title bars, rails, tabs, and the windows around an app."
        },
        {
            number: 5,
            slug: "buttons",
            title: "Buttons & Actions",
            summary: "Seven variants, three sizes, one focus ring, and the verbs around them."
        },
        {
            number: 6,
            slug: "forms",
            title: "Forms",
            summary: "Text, choices, dates, colors, files: every way to say what you mean."
        },
    ];
    in-out property <int> current: 0;
    in-out property <bool> backdrop-open: false;
    in-out property <bool> drawer-open: false;
    in-out property <bool> sheet-open: false;
    in-out property <bool> floating-open: false;
    // The saved workspace's first lines (empty until saved) and the last restore's outcome.
    in property <string> workspace-json;
    in property <string> workspace-note;
    callback workspace-save();
    callback workspace-restore();
    in property <string> save-shortcut: "Ctrl+S";
    in property <string> find-shortcut: "Ctrl+Shift+F";
    in property <[string]> quick-shortcuts: ["Ctrl+N", "Ctrl+O", "Ctrl+Shift+P", "Ctrl+,"];
    // The Buttons page's ActionSheet (buttons/actions.rs `action_sheet`).
    in-out property <bool> action-sheet-open: false;
    // Opens in dark mode; for captures.
    in property <bool> start-dark: false;
    // The current page's full height, so a capture can show it all.
    out property <length> capture-height: page-body.preferred-height;
    callback clicked(string);
    // The Window & Shell page's state and acts (gallery wire.rs).
    in property <[WindowTab]> tabs;
    in-out property <string> selected-tab: "roadmap";
    in property <bool> tray-shown;
    in property <string> tray-note: "nothing yet";
    in property <string> dock-reading;
    in-out property <bool> switcher-open: false;
    callback logged(string);
    callback tab-close(string);
    callback tab-add();
    callback tab-reorder(int, int);
    callback open-window(string);
    callback tray-toggle();
    callback tray-pick();
    callback badge(string);

    changed start-dark => {
        Theme.set-mode-now(start-dark ? Mode.dark : Mode.light);
    }

    ThemeFader { }

    HorizontalLayout {
        Rectangle {
            width: Theme.sidebar-width(false);
            background: Theme.colors.sunken;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;
                Text {
                    text: "Ely";
                    font-size: Theme.text-size(TextSize.lg);
                    font-weight: 600;
                    color: Theme.colors.fg;
                }

                for page[i] in root.pages: Button {
                    text: page.number + ". " + page.title;
                    variant: i == root.current ? ButtonVariant.subtle : ButtonVariant.ghost;
                    full-width: true;
                    clicked => {
                        root.current = i;
                    }
                }
                Button {
                    text: Theme.is-dark ? "Light mode" : "Dark mode";
                    variant: ButtonVariant.outline;
                    clicked => {
                        Theme.mode = Theme.is-dark ? Mode.light : Mode.dark;
                    }
                }
            }
        }

        Flickable {
            // A Flickable gives its content only its minimum height; the page wants its preferred one,
            // or stories that can shrink (a masonry, a split) are squeezed.
            page-body := VerticalLayout {
                min-height: self.preferred-height;
                padding: 32px;
                padding-top: 24px;
                alignment: start;
                Text {
                    text: root.pages[root.current].title;
                    font-size: Theme.text-size(TextSize.xl);
                    font-weight: 600;
                    color: Theme.colors.fg;
                }

                Text {
                    text: root.pages[root.current].summary;
                    font-size: Theme.text-size(TextSize.base);
                    color: Theme.colors.fg-muted;
                }

                if root.pages[root.current].slug == "primitives": PrimitivesPage {
                    backdrop-open <=> root.backdrop-open;
                }
                if root.pages[root.current].slug == "typography": TypographyPage { }
                if root.pages[root.current].slug == "layout": LayoutPage {
                    drawer-open <=> root.drawer-open;
                    sheet-open <=> root.sheet-open;
                    floating-open <=> root.floating-open;
                    workspace-json: root.workspace-json;
                    workspace-note: root.workspace-note;
                    workspace-save => {
                        root.workspace-save();
                    }
                    workspace-restore => {
                        root.workspace-restore();
                    }
                }
                if root.pages[root.current].slug == "shell": ShellPage {
                    tabs: root.tabs;
                    selected-tab <=> root.selected-tab;
                    tray-shown: root.tray-shown;
                    tray-note: root.tray-note;
                    dock-reading: root.dock-reading;
                    logged(what) => {
                        root.logged(what);
                    }
                    tab-close(id) => {
                        root.tab-close(id);
                    }
                    tab-add => {
                        root.tab-add();
                    }
                    tab-reorder(from, to) => {
                        root.tab-reorder(from, to);
                    }
                    open-window(which) => {
                        root.open-window(which);
                    }
                    tray-toggle => {
                        root.tray-toggle();
                    }
                    tray-pick => {
                        root.tray-pick();
                    }
                    badge(label) => {
                        root.badge(label);
                    }
                    switch-windows => {
                        root.switcher-open = true;
                    }
                }
                if root.pages[root.current].slug == "buttons": ButtonsPage {
                    save-shortcut: root.save-shortcut;
                    find-shortcut: root.find-shortcut;
                    quick-shortcuts: root.quick-shortcuts;
                    action-sheet-open <=> root.action-sheet-open;
                    clicked(name) => {
                        root.clicked(name);
                    }
                    logged(what) => {
                        root.logged(what);
                    }
                }
                if root.pages[root.current].slug == "forms": FormsPage {
                    logged(what) => {
                        root.logged(what);
                    }
                }
            }
        }
    }

    // The layout chapter's overlays (systems.rs `floating`, shells.rs `drawer`, `sheet`).
    if root.floating-open: FloatingPanel {
        title: "Inspector";
        start-x: 720px;
        start-y: 160px;
        panel-width: 240px;
        Caption {
            text: "Floating panels sit above the page.";
        }

        Tile {
            text: "Opacity 100%";
        }
    }

    if root.drawer-open: Drawer {
        close => {
            root.drawer-open = false;
        }
        Paragraph {
            text: "Drawers hold short tasks close to where the hand already is.";
        }

        Caption {
            text: "Drag the handle down, or click the scrim.";
        }
    }

    if root.sheet-open: Sheet {
        title: "Filters";
        close => {
            root.sheet-open = false;
        }
        Paragraph {
            text: "Sheets keep context visible while a side task runs.";
        }

        Tile {
            text: "Status: open";
        }

        Tile {
            text: "Owner: anyone";
        }
    }

    if root.backdrop-open: Backdrop {
        dismiss => {
            root.backdrop-open = false;
        }
        Elevated {
            width: 320px;
            elevation: Elevation.modal;
            background: Theme.colors.overlay;
            border-radius: Theme.radius(Radius.lg);
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text {
                    text: "Click outside to close.";
                    color: Theme.colors.fg-muted;
                }

                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Close";
                        clicked => {
                            root.backdrop-open = false;
                        }
                    }
                }
            }
        }
    }

    if root.action-sheet-open: ActionSheet {
        title: "dunes.jpg";
        message: "Taken at dusk. 4.2 MB.";
        actions: [
            { label: "Set as wallpaper" },
            { label: "Duplicate" },
            { label: "Delete photo", destructive: true },
        ];
        activated(ix) => {
            root.logged(["wallpaper", "duplicate", "delete photo"][ix]);
        }
        close => {
            root.action-sheet-open = false;
        }
    }

    if root.switcher-open: WindowSwitcher {
        close => {
            root.switcher-open = false;
        }
    }

    // Every option list on the page floats here, over the window (G54).
    OptionLayer { }
}
