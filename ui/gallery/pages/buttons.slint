// Page 5, Buttons & Actions, after ely-gallery/src/pages/buttons/mod.rs: every story in the
// source's order.

import { ButtonsBasics } from "buttons-basics.slint";
import { ButtonsChoices } from "buttons-choices.slint";
import { ButtonsLater, ButtonsActions } from "buttons-actions.slint";

export component ButtonsPage inherits VerticalLayout {
    // Shortcuts as the host spelled them (`ely_slint::shortcut_text`).
    in property <string> save-shortcut: "Ctrl+S";
    in property <string> find-shortcut: "Ctrl+Shift+F";
    in property <[string]> quick-shortcuts: ["Ctrl+N", "Ctrl+O", "Ctrl+Shift+P", "Ctrl+,"];
    in-out property <bool> action-sheet-open;

    callback clicked(name: string);
    callback logged(what: string);

    alignment: start;

    ButtonsBasics {
        save-shortcut: root.save-shortcut;
        find-shortcut: root.find-shortcut;
        clicked(name) => {
            root.clicked(name);
        }
    }

    ButtonsLater { }

    ButtonsChoices { }

    ButtonsActions {
        quick-shortcuts: root.quick-shortcuts;
        action-sheet-open <=> root.action-sheet-open;
        logged(what) => {
            root.logged(what);
        }
    }
}
