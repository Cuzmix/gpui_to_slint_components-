    // The blend a share `t` of the way from `a` to `b`, mixed per channel in sRGB like GPUI's `Mix`.
    public pure function mix(a: color, b: color, t: float) -> color {
        if (t <= 0) {
            return a;
        }
        if (t >= 1) {
            return b;
        }
        rgba(a.red + (b.red - a.red) * t, a.green + (b.green - a.green) * t, a.blue + (b.blue - a.blue) * t, (a.alpha + (b.alpha - a.alpha) * t) / 255)
    }

    // Every color of `a` blended a share `t` of the way to `b`.
    public pure function mix-palette(a: Palette, b: Palette, t: float) -> Palette {
        {
            bg: mix(a.bg, b.bg, t),
            surface: mix(a.surface, b.surface, t),
            sunken: mix(a.sunken, b.sunken, t),
            overlay: mix(a.overlay, b.overlay, t),
            hover: mix(a.hover, b.hover, t),
            active: mix(a.active, b.active, t),
            border: mix(a.border, b.border, t),
            border-strong: mix(a.border-strong, b.border-strong, t),
            fg: mix(a.fg, b.fg, t),
            fg-muted: mix(a.fg-muted, b.fg-muted, t),
            fg-subtle: mix(a.fg-subtle, b.fg-subtle, t),
            fg-disabled: mix(a.fg-disabled, b.fg-disabled, t),
            accent: mix(a.accent, b.accent, t),
            accent-hover: mix(a.accent-hover, b.accent-hover, t),
            on-accent: mix(a.on-accent, b.on-accent, t),
            on-media: mix(a.on-media, b.on-media, t),
            focus: mix(a.focus, b.focus, t),
            link: mix(a.link, b.link, t),
            selection: mix(a.selection, b.selection, t),
            success: mix(a.success, b.success, t),
            warning: mix(a.warning, b.warning, t),
            danger: mix(a.danger, b.danger, t),
            info: mix(a.info, b.info, t),
            success-subtle: mix(a.success-subtle, b.success-subtle, t),
            warning-subtle: mix(a.warning-subtle, b.warning-subtle, t),
            danger-subtle: mix(a.danger-subtle, b.danger-subtle, t),
            info-subtle: mix(a.info-subtle, b.info-subtle, t),
            backdrop: mix(a.backdrop, b.backdrop, t),
            media-backdrop: mix(a.media-backdrop, b.media-backdrop, t),
            shimmer: mix(a.shimmer, b.shimmer, t),
            glass: mix(a.glass, b.glass, t),
            shadow: mix(a.shadow, b.shadow, t),
            tooltip-bg: mix(a.tooltip-bg, b.tooltip-bg, t),
            tooltip-fg: mix(a.tooltip-fg, b.tooltip-fg, t),
            paper: mix(a.paper, b.paper, t),
            ink: mix(a.ink, b.ink, t),
            chart: [
                mix(a.chart[0], b.chart[0], t),
                mix(a.chart[1], b.chart[1], t),
                mix(a.chart[2], b.chart[2], t),
                mix(a.chart[3], b.chart[3], t),
                mix(a.chart[4], b.chart[4], t),
                mix(a.chart[5], b.chart[5], t),
                mix(a.chart[6], b.chart[6], t),
                mix(a.chart[7], b.chart[7], t)
            ],
            ansi: [
                mix(a.ansi[0], b.ansi[0], t),
                mix(a.ansi[1], b.ansi[1], t),
                mix(a.ansi[2], b.ansi[2], t),
                mix(a.ansi[3], b.ansi[3], t),
                mix(a.ansi[4], b.ansi[4], t),
                mix(a.ansi[5], b.ansi[5], t),
                mix(a.ansi[6], b.ansi[6], t),
                mix(a.ansi[7], b.ansi[7], t),
                mix(a.ansi[8], b.ansi[8], t),
                mix(a.ansi[9], b.ansi[9], t),
                mix(a.ansi[10], b.ansi[10], t),
                mix(a.ansi[11], b.ansi[11], t),
                mix(a.ansi[12], b.ansi[12], t),
                mix(a.ansi[13], b.ansi[13], t),
                mix(a.ansi[14], b.ansi[14], t),
                mix(a.ansi[15], b.ansi[15], t)
            ],
            syntax: {
                keyword: mix(a.syntax.keyword, b.syntax.keyword, t),
                string: mix(a.syntax.string, b.syntax.string, t),
                number: mix(a.syntax.number, b.syntax.number, t),
                comment: mix(a.syntax.comment, b.syntax.comment, t),
                function: mix(a.syntax.function, b.syntax.function, t),
                type-name: mix(a.syntax.type-name, b.syntax.type-name, t),
                constant: mix(a.syntax.constant, b.syntax.constant, t),
                property: mix(a.syntax.property, b.syntax.property, t),
                tag: mix(a.syntax.tag, b.syntax.tag, t),
                attribute: mix(a.syntax.attribute, b.syntax.attribute, t),
                operator: mix(a.syntax.operator, b.syntax.operator, t),
                punctuation: mix(a.syntax.punctuation, b.syntax.punctuation, t),
                variable: mix(a.syntax.variable, b.syntax.variable, t)
            },
        }
    }

    // `p` with its chart hues swapped for `chart`.
    public pure function with-chart(p: Palette, chart: [color]) -> Palette {
        {
            bg: p.bg,
            surface: p.surface,
            sunken: p.sunken,
            overlay: p.overlay,
            hover: p.hover,
            active: p.active,
            border: p.border,
            border-strong: p.border-strong,
            fg: p.fg,
            fg-muted: p.fg-muted,
            fg-subtle: p.fg-subtle,
            fg-disabled: p.fg-disabled,
            accent: p.accent,
            accent-hover: p.accent-hover,
            on-accent: p.on-accent,
            on-media: p.on-media,
            focus: p.focus,
            link: p.link,
            selection: p.selection,
            success: p.success,
            warning: p.warning,
            danger: p.danger,
            info: p.info,
            success-subtle: p.success-subtle,
            warning-subtle: p.warning-subtle,
            danger-subtle: p.danger-subtle,
            info-subtle: p.info-subtle,
            backdrop: p.backdrop,
            media-backdrop: p.media-backdrop,
            shimmer: p.shimmer,
            glass: p.glass,
            shadow: p.shadow,
            tooltip-bg: p.tooltip-bg,
