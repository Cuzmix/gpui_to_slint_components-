// Code token colors.
export struct Syntax {
    // Keywords: `fn`, `let`, `if`.
    keyword: color,
    // String literals.
    string: color,
    // Number literals.
    number: color,
    // Comments.
    comment: color,
    // Function names.
    function: color,
    // Type names.
    type-name: color,
    // Constants.
    constant: color,
    // Fields and properties.
    property: color,
    // Markup tags.
    tag: color,
    // Markup attributes and annotations.
    attribute: color,
    // Operators.
    operator: color,
    // Brackets, commas and the rest of the punctuation.
    punctuation: color,
    // Variables.
    variable: color,
}

// Semantic colors. Components read these, never literals.
export struct Palette {
    // The window's ground.
    bg: color,
    // Cards, fields and raised boxes.
    surface: color,
    // Wells and tracks set below the surface.
    sunken: color,
    // Menus, popovers and dialogs.
    overlay: color,
    // A fill under the pointer.
    hover: color,
    // A fill while pressed.
    active: color,
    // Hairlines between parts.
    border: color,
    // Lines that must read: outlines and rules.
    border-strong: color,
    // Body text.
    fg: color,
    // Secondary text.
    fg-muted: color,
    // Hints and placeholders, still 4.5:1 on the ground.
    fg-subtle: color,
    // Text that takes no input.
    fg-disabled: color,
    // The one accent: primary buttons and chosen items.
    accent: color,
    // The accent under the pointer.
    accent-hover: color,
    // Text and icons on the accent.
    on-accent: color,
    // Text and icons on a dark layer over pictures.
    on-media: color,
    // The focus ring.
    focus: color,
    // Links.
    link: color,
    // The wash behind selected text.
    selection: color,
    // Something worked.
    success: color,
    // Something may go wrong.
    warning: color,
    // Something failed or destroys.
    danger: color,
    // News that needs no action.
    info: color,
    // A soft fill behind success.
    success-subtle: color,
    // A soft fill behind a warning.
    warning-subtle: color,
    // A soft fill behind danger.
    danger-subtle: color,
    // A soft fill behind news.
    info-subtle: color,
    // The scrim under a dialog.
    backdrop: color,
    // The dark layer under pictures in a lightbox.
    media-backdrop: color,
    // The band that sweeps a skeleton.
    shimmer: color,
    // A pane the window's blur shows through.
    glass: color,
    // Shadows.
    shadow: color,
    // A tooltip's fill.
    tooltip-bg: color,
    // A tooltip's text.
    tooltip-fg: color,
    // The light ground of QR codes and barcodes, in both modes.
    paper: color,
    // The dark marks of QR codes and barcodes, in both modes.
    ink: color,
    // The chart's eight hues, named by Theme.hue-names.
    chart: [color],
    // The terminal's sixteen colors.
    ansi: [color],
    // Code token colors.
    syntax: Syntax,
}

